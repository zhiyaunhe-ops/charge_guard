# 本机数据 / 运行期状态，不进版本库
.workbuddy/
__pycache__/
*.pyc

# 脚本运行期自动生成的状态与日志
adb_port_cache.json
charge_guard_log.csv
full_charge.once
phone/phone_guard_log.csv
phone/guard.out
phone/watch_from_pc.log
phone/guard.pid

# 诊断脚本的产物（每次运行都会覆盖，结论已写进文档）
ble_probe_report.txt
charger_probe_report.txt

# 密钥：插座 token 用环境变量 CHARGE_GUARD_PLUG_TOKEN 注入
charge_guard.local.json
phone/charge_guard_phone.local.json
.env

# 第三方实现：各自有自己的 git 仓库，不 vendored 进来（克隆方式见 README）
third_party/

# Android 构建产物（APK 在 GitHub Actions 上构建，本机不留）
android/.gradle/
android/**/build/
android/local.properties
android/.idea/
android/dist/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
