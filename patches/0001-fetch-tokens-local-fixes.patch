+def stable_client_identity():
+    """[local patch] UA 与 deviceId 固定并缓存，跨次运行复用。
+
+    为什么：原实现每次运行都随机生成这两个值 —— 对小米账号系统来说，
+    这等价于「每次登录都换一台从没见过的新设备」，正好落在风控最敏感的输入上。
+    账号**没有开**二次验证也会因此被要求身份验证（风控触发，与账号设置那个开关无关）。
+    真实米家 App 同一次安装里这两个值本来就是稳定的，这里照做：第一次生成后落盘，之后一直用它。
+    """
+    try:
+        with open(CLIENT_FILE, encoding="utf-8") as f:
+            c = json.load(f)
+        if c.get("agent") and c.get("deviceId"):
+            return c["agent"], c["deviceId"]
+    except Exception:
+        pass
+    agent = ("".join(chr(random.randint(97, 122)) for _ in range(18))
+             + "-" + "".join(chr(random.randint(65, 69)) for _ in range(13))
+             + " APP/com.xiaomi.mihome APPV/10.5.201")
+    device_id = "".join(chr(random.randint(97, 122)) for _ in range(6))
+    try:
+        with open(CLIENT_FILE, "w", encoding="utf-8") as f:
+            json.dump({"agent": agent, "deviceId": device_id}, f, ensure_ascii=False, indent=2)
+    except OSError:
+        pass
+    return agent, device_id
+
