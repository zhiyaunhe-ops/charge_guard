+INPUT_MODE = os.environ.get("MI_INPUT", "auto").strip().lower()   # auto | tty | file
+
+
+def wait_for_input(path, prompt, timeout=600):
+    """[local patch] 取一个交互输入值：能问人就问人，问不了才等文件。
+
+    为什么两种都要：
+      - 人跑（双击 .bat）→ 直接手输最省事，这也正是上游原来的 input() 行为；
+      - 自动化 / agent 跑 → 给不出 stdin，于是约定「看到拦在等什么 → 把值写进文件」。
+    判定：stdin 是不是终端（isatty）。要强制可以设环境变量 MI_INPUT=tty 或 MI_INPUT=file。
+    """
+    mode = INPUT_MODE
+    if mode == "auto":
+        mode = "tty" if (sys.stdin and sys.stdin.isatty()) else "file"
+    if mode == "tty":
+        try:
+            val = input(prompt).strip()
+        except EOFError:
+            val = ""
+        if val:
+            return val
+        print("[i] 手输为空（stdin 可能被重定向了），改为等文件", flush=True)
+    print(prompt, flush=True)
+    print(f"[wait] 等待值写入 {path}（最长 {timeout}s）", flush=True)
+    end = time.time() + timeout
+    while time.time() < end:
+        if os.path.exists(path):
+            try:
+                with open(path, encoding="utf-8") as f:
+                    val = f.read().strip()
+            except OSError:
+                val = ""
+            if val:
+                try:
+                    os.unlink(path)
+                except OSError:
+                    pass
+                print("[wait] 取到值，继续", flush=True)
+                return val
+        time.sleep(1)
+    raise SystemExit(f"[-] 等待输入超时（{timeout}s）：{path}")
+
