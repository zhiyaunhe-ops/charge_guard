 # ----------------------------------------------------------------- captcha server
+def wait_for_input_file(path, prompt, timeout=600):
+    """[local patch] 从文件等待一个输入值，代替 input()。
+
+    为什么需要：这个流程有两处交互输入（图形验证码、邮件 2FA 码），而
+    非交互式的驱动方（自动化/agent）给不出 stdin。改成轮询文件之后，
+    驱动方可以「看到拦在等什么 → 把值写进文件 → 流程继续」。
+    """
+    print(prompt, flush=True)
+    print(f"[wait] 等待值写入 {path}（最长 {timeout}s）", flush=True)
+    end = time.time() + timeout
+    while time.time() < end:
+        if os.path.exists(path):
+            try:
+                with open(path, encoding="utf-8") as f:
+                    val = f.read().strip()
+            except OSError:
+                val = ""
+            if val:
+                try:
+                    os.unlink(path)
+                except OSError:
+                    pass
+                print("[wait] 取到值，继续", flush=True)
+                return val
+        time.sleep(1)
+    raise SystemExit(f"[-] 等待输入超时（{timeout}s）：{path}")
+
